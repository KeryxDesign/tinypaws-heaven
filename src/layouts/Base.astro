---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import { defaultLocale, type Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  ogImage?: string;
  noindex?: boolean;
  altLangPath?: string; // path della stessa pagina nell'altra lingua
}

const {
  title,
  description,
  lang = defaultLocale,
  ogImage,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : null;
const homeURL = new URL(import.meta.env.BASE_URL, Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Tiny Paws Haven 7',
  alternateName: 'Tiny Paws Haven',
  description:
    'A small, home-based cat fostering initiative in Tirana, Albania. We take in stray kittens, get them healthy, and help each one find a family.',
  url: homeURL,
  logo: new URL(`${import.meta.env.BASE_URL}favicon-512.png`, Astro.site).href,
  sameAs: ['https://www.instagram.com/tinypawshaven7/'],
  areaServed: { '@type': 'City', name: 'Tirana' },
  address: { '@type': 'PostalAddress', addressLocality: 'Tirana', addressCountry: 'AL' },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#FBF7F2" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tiny Paws Haven 7" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon-512.png`} sizes="512x512" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
