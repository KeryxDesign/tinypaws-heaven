---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';
interface Props { src?: ImageMetadata; alt: string; label?: string; class?: string; }
const { src, alt, label, class: cls = '' } = Astro.props;
---
{src ? (
  <Image src={src} alt={alt} class:list={['photo-img', cls]} widths={[400, 700, 1000]} sizes="(max-width: 700px) 100vw, 540px" />
) : (
  <div class:list={['photo-holder', cls]} role="img" aria-label={label ?? alt}>
    <Icon name="cat" class="photo-holder__cat" />
    {label && <span class="photo-holder__label">{label}</span>}
  </div>
)}
<style>
  .photo-img { width: 100%; height: 100%; object-fit: cover; }
  .photo-holder__cat { color: var(--color-cinnamon); }
  .photo-holder__label { font-family: var(--font-body); font-style: italic; font-size: .95rem; color: var(--color-cinnamon); }
</style>
