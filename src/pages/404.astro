---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { localizedPath } from '../i18n/ui';
const base = import.meta.env.BASE_URL;
---
<Base title="Page not found · Tiny Paws Haven 7" description="This page wandered off. Let's get you back home." lang="en" noindex>
  <main class="nf">
    <span class="nf__cat"><Icon name="cat" /></span>
    <p class="nf__code">404</p>
    <h1 class="nf__h">This page wandered off</h1>
    <p class="nf__p">The page you’re looking for isn’t here. But there’s always a kitten waiting on the home page.</p>
    <a class="btn btn-primary" href={localizedPath(base, 'en', '')}>
      <Icon name="paw" class="nf__paw" />Back home
    </a>
  </main>
</Base>
<style>
  .nf { min-height: 78vh; display: grid; place-content: center; justify-items: center; text-align: center; gap: .7rem; padding: 3rem 1.5rem; }
  .nf__cat { width: 5rem; height: 5rem; color: var(--color-apricot); }
  .nf__code { font-family: var(--font-body); font-style: italic; color: var(--color-terracotta); font-size: 1.1rem; }
  .nf__h { font-size: clamp(2rem, 6vw, 3rem); }
  .nf__p { max-width: 30rem; margin-top: .3rem; }
  .btn { margin-top: 1.4rem; }
  .nf__paw { width: 1.15rem; height: 1.15rem; }
</style>
