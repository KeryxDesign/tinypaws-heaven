---
// Icone di brand — SVG a tratto, coerenti col logo (mai icone lucide/emoji).
interface Props { name: 'paw' | 'instagram' | 'arrow' | 'check' | 'cat' | 'roof' | 'heart'; class?: string; }
const { name, class: cls = '' } = Astro.props;
---
{name === 'paw' && (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <ellipse cx="6.5" cy="10" rx="2" ry="2.6"/><ellipse cx="12" cy="8.2" rx="2.1" ry="2.8"/>
    <ellipse cx="17.5" cy="10" rx="2" ry="2.6"/><path d="M12 12c-3 0-5.2 2-5.2 4.3 0 1.6 1.3 2.4 3 2.4 1 0 1.6-.4 2.2-.4s1.2.4 2.2.4c1.7 0 3-.8 3-2.4C17.2 14 15 12 12 12Z"/>
  </svg>
)}
{name === 'instagram' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/>
  </svg>
)}
{name === 'arrow' && (
  <svg class={cls} viewBox="0 0 48 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 12c8 0 14-3 22-3M40 9l5 3-5 4M25 9c6 0 10 1 15 3"/>
  </svg>
)}
{name === 'check' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 12.5l4.5 4.5L19 7"/>
  </svg>
)}
{name === 'heart' && (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 21s-7.5-4.7-9.7-9C.9 8.6 2.4 5 5.8 5 8 5 9.4 6.4 12 9.2 14.6 6.4 16 5 18.2 5c3.4 0 4.9 3.6 3.5 7-2.2 4.3-9.7 9-9.7 9Z"/>
  </svg>
)}
{name === 'roof' && (
  <svg class={cls} viewBox="0 0 200 30" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" aria-hidden="true">
    <path d="M6 26 100 6l94 20"/>
  </svg>
)}
{name === 'cat' && (
  <svg class={cls} viewBox="0 0 120 120" fill="currentColor" aria-hidden="true">
    <path d="M38 26c-2-8-1-14 2-13 4 1 9 6 12 12a34 34 0 0 1 16 0c3-6 8-11 12-12 3-1 4 5 2 13 7 6 11 15 11 25 0 22-18 39-33 39S27 73 27 51c0-10 4-19 11-25Z"/>
    <path d="M52 96c-14-2-25-8-25-8s0 14 33 14 33-14 33-14-11 6-25 8c-2 6-14 6-16 0Z" opacity=".5"/>
  </svg>
)}
